NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MySQL (used from Phase 2 with Prisma)
DATABASE_URL="mysql://root:rootpassword@localhost:3306/careertrack"

# JWT (used from Phase 4). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Storage driver: local now, s3 later
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
